# Copy this file to .env and update values as needed

# PostgreSQL
POSTGRES_DB=finnexus_db
POSTGRES_USER=finnexus
POSTGRES_PASSWORD=finnexus123

# Neo4j
NEO4J_AUTH=neo4j/finnexus123

# Backend
DATABASE_URL=postgresql://finnexus:finnexus123@postgres:5432/finnexus_db
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=finnexus123

# Auth (JWT)
# Tạo secret ngẫu nhiên, ví dụ: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000

# Google OAuth (xem README mục "Cấu hình đăng nhập Google")
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# SMTP (gửi email đặt lại mật khẩu, xem README mục "Cấu hình SMTP")
# Để trống SMTP_HOST nếu chưa cấu hình: link reset sẽ được in ra log backend thay vì gửi email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@finnexus.local
