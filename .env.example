# Sao chép file này thành .env rồi điền giá trị thật.

# development | production
# production sẽ: không seed tài khoản test, tắt /docs, và BẮT BUỘC JWT_SECRET_KEY thật.
ENVIRONMENT=development

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=finnexus_db
POSTGRES_USER=finnexus
# Bắt buộc. Không có giá trị mặc định — compose sẽ từ chối khởi động nếu thiếu.
POSTGRES_PASSWORD=

# ─── Auth ────────────────────────────────────────────────────
# Bắt buộc, tối thiểu 32 ký tự trong production.
# Sinh: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
FRONTEND_URL=http://localhost:3000

# ─── Mô hình dự đoán FinNexus KG ─────────────────────────────
# Đường dẫn tới repo nghiên cứu chứa config/inference_article_scoring_v1.yaml
# và outputs/model_experiments/. Compose mount thư mục này vào /finnexus (read-only).
# Bỏ trống -> hệ thống chạy bằng bộ luật heuristic và nói rõ điều đó trên giao diện.
FINNEXUS_ROOT=../FinNexus KG

# ─── Firebase Phone Auth (không có lối vào từ giao diện) ─────────
# Đăng ký/đăng nhập hiện chỉ còn một kênh: OTP qua email (xem SMTP bên dưới).
# Endpoint backend /auth/firebase-phone, /auth/login-phone, /auth/link-phone
# vẫn còn và hoạt động nếu gọi trực tiếp, nhưng không có nút nào trên giao
# diện gọi tới chúng nữa. Để trống FIREBASE_PROJECT_ID thì các endpoint đó
# trả 503. Giữ biến này lại chỉ để phòng khi cần bật lại UI sau này.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# ─── SMTP ───────────────────────────────────────────────────
# Bắt buộc để mã OTP đăng ký/đăng nhập bằng EMAIL thật sự được gửi đi (và để
# link quên-mật-khẩu được gửi qua email) — để trống SMTP_HOST thì mã/link chỉ
# được ghi ra log backend, không gửi thật.
# Dùng Gmail: bật xác minh 2 bước cho tài khoản Gmail rồi tạo "Mật khẩu ứng
# dụng" tại https://myaccount.google.com/apppasswords — dùng mật khẩu đó cho
# SMTP_PASSWORD (không dùng mật khẩu Gmail thường). SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@finnexus.local

# ─── Claude — giải thích bài báo (tuỳ chọn) ──────────────────
# Để trống thì nút "Nhờ Claude giải thích" tự tắt; mọi thứ khác vẫn chạy.
# Mỗi bài chỉ gọi API một lần rồi được lưu lại trong cơ sở dữ liệu.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
